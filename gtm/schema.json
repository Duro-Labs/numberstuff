{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["parameters", "events"],
  "additionalProperties": false,
  "properties": {
    "parameters": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$" }, "uniqueItems": true },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "parameters", "keyEvent"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$" },
          "parameters": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "keyEvent": { "type": "boolean" }
        }
      }
    }
  }
}
